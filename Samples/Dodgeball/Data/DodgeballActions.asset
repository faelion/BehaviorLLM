%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 502da20ed55950e4c9f51dedfc14f6b3, type: 3}
  m_Name: DodgeballActions
  m_EditorClassIdentifier: BehaviorLLM.Runtime::BehaviorLLM.Core.Actions.ActionConfig
  validActions:
  - actionName: Move
    description: Hold a direction until your next input. Forward is toward the center
      line, Up toward the top wall.
    parameters:
    - name: direction
      type: 1
      exampleValue: Forward
      allowedValues:
      - Forward
      - Back
      - Up
      - Down
      - ForwardUp
      - ForwardDown
      - BackUp
      - BackDown
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Stand
    description: Let go of the stick and stand still.
    parameters: []
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Throw
    description: 'Throw your ball: at the opponent, or ahead of them toward the top
      or the bottom wall.'
    parameters:
    - name: aim
      type: 1
      exampleValue: AtOpponent
      allowedValues:
      - AtOpponent
      - LeadUp
      - LeadDown
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Catch
    description: Open a catch for a moment. A ball that arrives while it is open
      is caught and you score.
    parameters: []
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Dodge
    description: A quick burst a couple of metres up, down or back.
    parameters:
    - name: direction
      type: 1
      exampleValue: Up
      allowedValues:
      - Up
      - Down
      - Back
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  modelInstructions: 'Each turn you press one input. A direction stays held until
    your next input.

    If a ball will hit you, dodge up or down out of its line,
    or catch it if it arrives very soon.

    If you have no ball, run to the nearest
    free ball on your side.

    Throws only count from behind your throwing line,
    away from the center.

    If you can throw, throw.'
