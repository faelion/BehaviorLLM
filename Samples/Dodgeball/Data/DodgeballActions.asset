%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 502da20ed55950e4c9f51dedfc14f6b3, type: 3}
  m_Name: DodgeballActions
  m_EditorClassIdentifier: BehaviorLLM.Runtime::BehaviorLLM.Core.Actions.ActionConfig
  validActions:
  - actionName: Move
    description: Hold a direction until your next input. Forward is toward the center
      line, Up toward the top wall.
    parameters:
    - name: direction
      type: 1
      exampleValue: Forward
      allowedValues:
      - Forward
      - Back
      - Up
      - Down
      - ForwardUp
      - ForwardDown
      - BackUp
      - BackDown
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Stand
    description: Let go of the stick and stand still.
    parameters: []
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Throw
    description: 'Charge and throw the ball in your throwing hand: at the opponent,
      ahead of where they run, a metre or two above or below them, or off the top
      or bottom wall.'
    parameters:
    - name: aim
      type: 1
      exampleValue: AtOpponent
      allowedValues:
      - AtOpponent
      - AheadOfOpponent
      - OffsetUp1
      - OffsetUp2
      - OffsetDown1
      - OffsetDown2
      - BankTopWall
      - BankBottomWall
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Catch
    description: Open a catch for a moment, dropping any balls you hold. A ball that
      arrives while it is open is caught and you score.
    parameters: []
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Dodge
    description: A quick burst a couple of metres up, down or back.
    parameters:
    - name: direction
      type: 1
      exampleValue: Up
      allowedValues:
      - Up
      - Down
      - Back
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  modelInstructions: 'Each turn you press one input. A direction stays held until
    your next input.

    If a ball will hit you, dodge up or down out of its line,
    or catch it if it is already close and coming at you.

    If you have no ball, run to the nearest
    free ball on your side.

    Throws only count from behind your throwing line,
    away from the center.

    Be smart about when to throw, and take advantage of your opponent''s cooldowns.'
