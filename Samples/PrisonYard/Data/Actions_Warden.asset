--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 502da20ed55950e4c9f51dedfc14f6b3, type: 3}
  m_Name: Actions_Warden
  m_EditorClassIdentifier: BehaviorLLM.Runtime::BehaviorLLM.Core.Actions.ActionConfig
  validActions:
  - actionName: Observe
    description: Change nothing and keep watching.
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Lockdown
    description: Shut a section so nobody can go in or out.
    parameterType: 1
    exampleArgument: Yard
    allowedArguments: []
  - actionName: LiftLockdown
    description: Reopen a section that is shut.
    parameterType: 1
    exampleArgument: Yard
    allowedArguments: []
  - actionName: Reinforce
    description: Send the nearest free officer to a section.
    parameterType: 1
    exampleArgument: Yard
    allowedArguments: []
  - actionName: Announce
    description: Say something to the whole prison over the radio.
    parameterType: 1
    exampleArgument: StayCalm
    allowedArguments:
    - ReturnToCells
    - StayCalm
    - MealTime
    - YardTime
  modelInstructions: 'Choose exactly one action per turn.

    Prefer the least disruptive
    response that resolves the incident.

    Lift a lockdown once that section is
    quiet again.'
