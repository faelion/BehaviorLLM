--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 502da20ed55950e4c9f51dedfc14f6b3, type: 3}
  m_Name: Actions_Prisoner
  m_EditorClassIdentifier: BehaviorLLM.Runtime::BehaviorLLM.Core.Actions.ActionConfig
  validActions:
  - actionName: FollowSchedule
    description: Go where the schedule says you should be.
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  - actionName: Wander
    description: Walk to another part of the prison you are allowed into.
    parameterType: 1
    exampleArgument: Yard
    allowedArguments: []
  - actionName: Talk
    description: Stand and talk with another prisoner.
    parameterType: 1
    exampleArgument: Prisoner_02
    allowedArguments: []
  - actionName: Fight
    description: Attack another prisoner.
    parameterType: 1
    exampleArgument: Prisoner_01
    allowedArguments: []
  - actionName: Hide
    description: Stash what you are carrying somewhere out of sight.
    parameterType: 1
    exampleArgument: Workshop_Corner
    allowedArguments: []
  - actionName: Sneak
    description: Slip into a part of the prison you are not supposed to be in.
    parameterType: 1
    exampleArgument: Workshop
    allowedArguments: []
  - actionName: Comply
    description: Do as the officer says and stay still.
    parameterType: 0
    exampleArgument: 
    allowedArguments: []
  modelInstructions: 'Choose exactly one action per turn.

    Follow the schedule
    unless something better is on the menu.

    Prefer doing something over standing
    still.'
